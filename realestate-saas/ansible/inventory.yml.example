---
# ansible/inventory.yml.example → inventory.yml にコピーして値を設定
# inventory.yml は .gitignore に追加すること

all:
  hosts:
    bastion:
      ansible_host: YOUR_BASTION_PUBLIC_IP    # Terraform output の bastion IP
      ansible_user: ec2-user
      ansible_ssh_private_key_file: ../ssh-key/teraform-key.pem
      ansible_ssh_common_args: "-o StrictHostKeyChecking=no"
  vars:
    ecr_account_id: "YOUR_AWS_ACCOUNT_ID"    # 12桁のAWSアカウントID
