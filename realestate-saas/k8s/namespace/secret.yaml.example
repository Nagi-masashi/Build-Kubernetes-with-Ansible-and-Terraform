# ⚠️  このファイルをコピーして secret.yaml を作成し、値を base64 エンコードしてください
# echo -n "your-value" | base64
# secret.yaml は .gitignore に追加すること！

apiVersion: v1
kind: Secret
metadata:
  name: realestate-secrets
  namespace: realestate-saas
type: Opaque
data:
  # Anthropic API Key: echo -n "sk-ant-xxxx" | base64
  ANTHROPIC_API_KEY: "BASE64_ENCODED_ANTHROPIC_API_KEY"

  # Supabase Service Role Key
  SUPABASE_SERVICE_ROLE_KEY: "BASE64_ENCODED_SUPABASE_KEY"

  # Stripe Secret Key (課金)
  STRIPE_SECRET_KEY: "BASE64_ENCODED_STRIPE_SECRET"
  STRIPE_WEBHOOK_SECRET: "BASE64_ENCODED_STRIPE_WEBHOOK"

  # JWT Secret (認証)
  JWT_SECRET: "BASE64_ENCODED_JWT_SECRET_MIN_32CHARS"

  # Next.js
  NEXTAUTH_SECRET: "BASE64_ENCODED_NEXTAUTH_SECRET"
